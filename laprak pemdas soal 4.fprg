<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="laprak pemdas soal 4"/>
        <attribute name="authors" value="Gilma"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-07 03:34:38 PM"/>
        <attribute name="created" value="R2lsbWE7R0lMTUFSOzIwMjYtMDktMDc7MDM6Mjc6NDMgUE07MjIyMw=="/>
        <attribute name="edited" value="R2lsbWE7R0lMTUFSOzIwMjYtMDktMDc7MDM6MzQ6MzggUE07MTsyMzMz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="usia, masaKerja" type="Integer" array="False" size=""/>
            <declare name="penghasilan, cicilan" type="Real" array="False" size=""/>
            <declare name="status" type="String" array="False" size=""/>
            <input variable="usia"/>
            <input variable="penghasilan"/>
            <input variable="cicilan"/>
            <input variable="masaKerja"/>
            <if expression="(usia &gt;= 21 AND usia &lt;= 55) AND (penghasilan &gt;= 3000000) AND (cicilan &lt;= 0.30 * penghasilan) AND (masaKerja &gt;= 2)">
                <then>
                    <assign variable="status" expression="&quot;Disetujui&quot;"/>
                </then>
                <else>
                    <assign variable="status" expression="&quot;Ditolak&quot;"/>
                </else>
            </if>
            <output expression="status" newline="True"/>
        </body>
    </function>
</flowgorithm>
