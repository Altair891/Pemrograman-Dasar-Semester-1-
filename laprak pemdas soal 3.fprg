<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="laprak pemdas soal 3"/>
        <attribute name="authors" value="Gilma"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-07 03:11:05 PM"/>
        <attribute name="created" value="R2lsbWE7R0lMTUFSOzIwMjYtMDktMDc7MDM6MDA6NDEgUE07MjIxMg=="/>
        <attribute name="edited" value="R2lsbWE7R0lMTUFSOzIwMjYtMDktMDc7MDM6MTE6MDUgUE07MTsyMzIy"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="totalBelanja, beratPaket, ongkir, tarifDasar, biayaBerat, biayaLokasi" type="Real" array="False" size=""/>
            <declare name="luarJawa" type="Boolean" array="False" size=""/>
            <input variable="totalBelanja"/>
            <input variable="beratPaket"/>
            <input variable="luarJawa"/>
            <if expression="(totalBelanja &gt;= 200000) AND (beratPaket &lt;= 3)">
                <then>
                    <assign variable="ongkir" expression="0"/>
                </then>
                <else>
                    <assign variable="tarifDasar" expression="10000"/>
                    <if expression="beratPaket &gt; 3">
                        <then>
                            <assign variable="biayaBerat" expression="(beratPaket - 3) * 5000"/>
                        </then>
                        <else>
                            <assign variable="biayaBerat" expression="0"/>
                        </else>
                    </if>
                    <if expression="luarJawa == true">
                        <then>
                            <assign variable="biayaLokasi" expression="15000"/>
                        </then>
                        <else>
                            <assign variable="biayaLokasi" expression="0"/>
                        </else>
                    </if>
                    <assign variable="ongkir" expression="tarifDasar + biayaBerat + biayaLokasi"/>
                </else>
            </if>
            <output expression="ongkir" newline="True"/>
        </body>
    </function>
</flowgorithm>
